# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# Third-party model weights — fetched by `python -m scripts.fetch_assets`.
# Never commit these (~700 MB total).
*.pth
*.onnx
*.task
yolo*.pt          # e.g. yolo11x-pose.pt if downloaded into the working directory

# The production rankers ARE committed (2 MB each) — keep them exempt.
!image_filterer/model/ranker.pt
!image_filterer/model/ranker_v1.pt

# Run storage, feature cache, and datasets live outside the repo by default
# ($IMAGE_FILTERER_DATA_ROOT). These entries only matter if someone points them in-tree.
data/
runs/
cache/
assets/
dataset/
*.db
.session_secret
viewer_names.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Machine-specific launcher — hardcodes this checkout's absolute path, so it
# won't work from a clone on someone else's machine. start.sh is the portable
# part and stays tracked.
/*.desktop
