# Copy to .env.spark and fill in. Read by start-spark.sh / compose.spark.yaml.
# .env.spark is machine-specific (and may hold a password): never commit it.

# Required: a host folder for everything the app keeps (database, runs, feature
# cache, model weights ~5 GB). Must already exist and be writable by SPARK_UID.
SPARK_DATA_DIR=/srv/image-filterer

# The host user/group the container runs as (`id -u`, `id -g`): files it
# writes into SPARK_DATA_DIR and EXPORT_PATH are owned by them.
SPARK_UID=1000
SPARK_GID=1000

# Optional: photos the app may read, mounted read-only at /photos (e.g. a
# LucidLink share). Leave empty for upload-only use.
PHOTO_SOURCE_PATH=

# Optional: where server-side exports and auto-export go, mounted at /exports.
# Must already exist. Leave empty to offer browser downloads only.
EXPORT_PATH=

# Leave empty: start-spark.sh asks for tonight's password at `up` and never
# stores it. Set it only for unattended starts (then protect this file).
IMAGE_FILTERER_PASSWORD=

# Optional: Slack/Teams incoming-webhook URL for problem alerts (Lucid
# unreachable, export folder missing, …). Problems always show as a banner.
IMAGE_FILTERER_ALERT_WEBHOOK=

# Optional tuning (defaults shown).
# SPARK_BIND_IP=0.0.0.0
# SPARK_PORT=8600
# IMAGE_FILTERER_OCR_WORKERS=4
# IMAGE_FILTERER_MEM_CACHE_MB=1024
# SPARK_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3
